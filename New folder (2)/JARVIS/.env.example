# JARVIS Independence Config - NO external APIs
# All responses generated by local Ollama models only
# Models: llama3.2:1b, qwen2.5:3b, qwen2.5-coder:3b

# LOCAL AI
OLLAMA_HOST=http://127.0.0.1:11434

# VOICE
WAKE_WORD=hey jarvis
TTS_ENGINE=piper

# VENOM INTEGRATION
VENOM_FOLDER_PATH=C:/path/to/your/venom/folder
VENOM_API_URL=http://localhost:8080
VENOM_API_KEY=your_venom_key_if_applicable

# INTEGRATIONS
GITHUB_TOKEN=your_github_token
ASANA_TOKEN=your_asana_token
SLACK_BOT_TOKEN=your_slack_bot_token

# SERVER
PORT=3001
FRONTEND_URL=http://localhost:3000
NODE_ENV=development

# SECURITY
SESSION_SECRET=generate_a_random_32char_string_here
COOKIE_SECRET=generate_another_random_32char_string
