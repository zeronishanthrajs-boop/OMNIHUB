# ==============================================================================
# OMNIHUB ECOSYSTEM — MASTER UNIFIED ENVIRONMENT TEMPLATE
# ==============================================================================
# Copy this file to .env and populate with your production or local secrets.
# NEVER commit .env to Git or public repositories!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE ORCHESTRATION & MASTER SERVER
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=8080
MASTER_HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. AUTONOMOUS AI & MULTI-AGENT ENGINES (ULTRON, JARVIS, AI Web Builder)
# ------------------------------------------------------------------------------
# LLM Execution Mode: "local" (100% private, free) or "api" (Cloud)
LLM_BACKEND=local
LOCAL_LLM_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL_NAME=llama3.1:8b

# Cloud AI Provider API Keys (Optional fallbacks)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
NVIDIA_API_KEY=
NVIDIA_MODEL_NAME=meta/llama-3.1-8b-instruct
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------------------
# 3. FINTECH & MARKET INTELLIGENCE (Stock Pulse, Prediction Areena)
# ------------------------------------------------------------------------------
# JWT Secret for Session Cookies & Cryptographic tokens (32+ chars)
JWT_SECRET=your_super_secret_jwt_key_32_characters_minimum
# Secret key for HMAC Rewarded Ads & outcome validation
AD_VERIFICATION_SECRET=your_hmac_secret_crypto_hash_key_2026

# Optional: Custom SQLite / LibSQL database path
# DB_PATH=/tmp/prediction_arena.db

# ------------------------------------------------------------------------------
# 4. CYBERSECURITY & THREAT TELEMETRY (CYBER TREE, VENOM, Whisper Pages)
# ------------------------------------------------------------------------------
# Supabase Configuration (CYBER TREE)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# VENOM Security Scanner Configuration
VENOM_API_KEY=replace_with_strong_random_key
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/venom
NVD_API_KEY=
NVD_API_URL=https://services.nvd.nist.gov/rest/json/cves/2.0
ENABLE_INMEMORY_DB=true

# Whisper Pages Secret Passphrase Salt (Optional)
WHISPER_SECRET_SALT=quantum_safe_salt_mlkem_1024

# ------------------------------------------------------------------------------
# 5. CREATIVE & DYNAMIC FORMS (jo form, MorphCart, Decluz, Chess)
# ------------------------------------------------------------------------------
# Institution Customization for Jo Form
NEXT_PUBLIC_COLLEGE_NAME="Sambhram Academy of Management Studies (SAMS)"
NEXT_PUBLIC_COLLEGE_ADDRESS="M.S. Palya, Jalahalli East, Bangalore – 560097, Karnataka, India"
NEXT_PUBLIC_COLLEGE_AFFILIATION="Affiliated to Bengaluru City University (BCU)"
NEXT_PUBLIC_DEPARTMENT_NAME="Department of Computer Applications (BCA)"
NEXT_PUBLIC_ACADEMIC_YEAR="2025–2026"
NEXT_PUBLIC_COLLEGE_WEBSITE="www.sambhram.org"
OFFICE_EMAIL="sams@sambhram.org"

# SMTP Transport for Form Notifications (Optional - Simulation Mode active by default)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your_email@gmail.com
# SMTP_PASS=your_app_password
# SMTP_FROM="NAAC Portal <no-reply@college.edu>"

# ------------------------------------------------------------------------------
# 6. OPTIONAL VERCEL CLOUD DOMAIN OVERRIDES
# ------------------------------------------------------------------------------
# Active Live Vercel Deployments:
VERCEL_URL_PREDICTION_ARENA=https://prediction-areena.vercel.app/
VERCEL_URL_CYBER_TREE=https://cyber-tree-azure.vercel.app/
VERCEL_URL_VENOM=https://dashboard-sigma-puce-87.vercel.app/onboard
# Additional overrides if deployed:
# VERCEL_URL_ULTRON=https://ultron-os.vercel.app
# VERCEL_URL_JARVIS=https://jarvis-elite.vercel.app
# VERCEL_URL_DECLUZ=https://decluz-portfolio.vercel.app
